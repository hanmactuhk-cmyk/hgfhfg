{
  "name": "glabs-flow-automation",
  "version": "1.0.0",
  "description": "Chrome-profile browser automation for Google Flow with prompt queue and downloads.",
  "main": "main.js",
  "author": "G-Labs Flow Automation",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.glabs.flowautomation",
    "productName": "G-Labs Flow Automation",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "automation/**/*",
      "renderer/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "G-Labs-Flow-Automation-${version}.exe"
    }
  }
}
